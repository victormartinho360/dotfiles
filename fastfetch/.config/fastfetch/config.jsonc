{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "~/.config/fastfetch/gojo.png",
        "width": 28,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " {#38;2;86;95;137}󰅂{#} ",
        "color": {
            "keys": "38;2;187;154;247",
            "title": "38;2;125;207;255",
            "output": "38;2;192;202;245",
            "separator": "38;2;86;95;137"
        },
        "key": {
            "width": 16
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": {
                "left": "{#38;2;59;66;97}[{#}",
                "right": "{#38;2;59;66;97}]{#}"
            },
            "color": {
                "elapsed": "38;2;187;154;247",
                "total": "38;2;59;66;97"
            },
            "width": 12
        },
        "percent": {
            "type": ["num", "bar"],
            "color": {
                "green": "38;2;125;207;255",
                "yellow": "38;2;187;154;247",
                "red": "38;2;247;118;142"
            }
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}╭─────────────────── {#38;2;122;162;247}●{#} {#38;2;247;118;142}●{#} {#38;2;86;95;137}󰁔{#} {#1;38;2;187;154;247}◉ 虚式「茈」{#}{#38;2;59;66;97} ───────────────────╮{#}"
        },
        {
            "type": "title",
            "key": "{#38;2;59;66;97}│{#} {#1;38;2;187;154;247}󰣇 Sorcerer{#}",
            "format": "{#1;38;2;125;207;255}{user-name}{#}{#38;2;86;95;137}@{#}{#1;38;2;187;154;247}{host-name}{#}"
        },
        {
            "type": "datetime",
            "key": "{#38;2;59;66;97}│{#} {#38;2;187;154;247}󰃰 Domain{#}",
            "format": "{#38;2;192;202;245}{year}-{month-pretty}-{day-in-month}{#}{#38;2;86;95;137} • {#}{#38;2;125;207;255}{hour-pretty}:{minute-pretty}:{second-pretty}{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}├─────────────────── {#1;38;2;125;207;255}󰈈 SIX EYES // SYSTEM{#}{#38;2;59;66;97} ──────────────────┤{#}"
        },
        {
            "type": "os",
            "key": "{#38;2;59;66;97}│{#} {#38;2;125;207;255}├─ {icon} Distro{#}",
            "format": "{pretty-name} {#38;2;86;95;137}[{arch}]{#}"
        },
        {
            "type": "kernel",
            "key": "{#38;2;59;66;97}│{#} {#38;2;125;207;255}├─  Kernel{#}",
            "format": "{sysname} {release}"
        },
        {
            "type": "packages",
            "key": "{#38;2;59;66;97}│{#} {#38;2;125;207;255}├─ 󰏖 Packages{#}"
        },
        {
            "type": "uptime",
            "key": "{#38;2;59;66;97}│{#} {#38;2;125;207;255}╰─ 󰅐 Uptime{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}├─────────────────── {#1;38;2;122;162;247}󰆍 LIMITLESS // ENV{#}{#38;2;59;66;97} ────────────────────┤{#}"
        },
        {
            "type": "shell",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247}├─  Shell{#}",
            "format": "{pretty-name} {#38;2;86;95;137}v{version}{#}"
        },
        {
            "type": "terminal",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247}├─  Terminal{#}",
            "format": "{pretty-name}"
        },
        {
            "type": "terminalfont",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247}├─  Font{#}",
            "format": "{name} {#38;2;86;95;137}({size}){#}"
        },
        {
            "type": "wm",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247}├─  WM / DE{#}",
            "format": "{pretty-name} {#38;2;86;95;137}({protocol-name}){#}"
        },
        {
            "type": "editor",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247}╰─  Editor{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}├─────────────────── {#1;38;2;247;118;142}󰓅 REVERSAL // HARDWARE{#}{#38;2;59;66;97} ────────────────┤{#}"
        },
        {
            "type": "host",
            "key": "{#38;2;59;66;97}│{#} {#38;2;247;118;142}├─ 󰌢 Machine{#}",
            "format": "{name}"
        },
        {
            "type": "cpu",
            "key": "{#38;2;59;66;97}│{#} {#38;2;247;118;142}├─ 󰻠 CPU{#}",
            "showPeCoreCount": true,
            "format": "{name} {#38;2;86;95;137}({cores-logical}T @ {freq-max}){#}"
        },
        {
            "type": "gpu",
            "key": "{#38;2;59;66;97}│{#} {#38;2;247;118;142}├─ 󰍛 GPU{#}",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "{#38;2;59;66;97}│{#} {#38;2;187;154;247}├─ 󰑭 Memory{#}",
            "format": "{percentage-bar} {#38;2;192;202;245}{used}{#}{#38;2;86;95;137} / {#}{#38;2;86;95;137}{total}{#}"
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "{#38;2;59;66;97}│{#} {#38;2;187;154;247}├─ 󰉉 Disk (/){#}",
            "format": "{size-percentage-bar} {#38;2;192;202;245}{size-used}{#}{#38;2;86;95;137} / {#}{#38;2;86;95;137}{size-total}{#}"
        },
        {
            "type": "localip",
            "compact": true,
            "key": "{#38;2;59;66;97}│{#} {#38;2;187;154;247}╰─ 󰩟 Local IP{#}",
            "format": "{ipv4} {#38;2;86;95;137}({ifname}){#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}├───────────────────────────────────────────────────────────┤{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}│{#}   {#38;2;22;22;30} {#}  {#38;2;247;118;142} {#}  {#38;2;158;206;106} {#}  {#38;2;224;175;104} {#}  {#38;2;122;162;247} {#}  {#38;2;187;154;247} {#}  {#38;2;125;207;255} {#}  {#38;2;192;202;245} {#}   {#38;2;86;95;137}│{#}   {#1;38;2;187;154;247}Throughout Heaven and Earth{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}╰───────────────────────────────────────────────────────────╯{#}"
        }
    ]
}
