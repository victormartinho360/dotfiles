{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "~/.config/fastfetch/gojo.png",
        "width": 24,
        "preserveAspectRatio": true,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;187;154;247",
            "title": "38;2;125;207;255",
            "output": "38;2;192;202;245",
            "separator": "38;2;86;95;137"
        },
        "constants": [
            "\u001b[38;2;59;66;97m│\u001b[52C│\u001b[53D"
        ],
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": {
                "left": "[",
                "right": "]"
            },
            "color": {
                "elapsed": "38;2;187;154;247",
                "total": "38;2;59;66;97",
                "border": "38;2;86;95;137"
            },
            "width": 12
        },
        "percent": {
            "type": ["num", "bar"],
            "color": {
                "green": "38;2;125;207;255",
                "yellow": "38;2;187;154;247",
                "red": "38;2;247;118;142"
            }
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}╭───────────────┬──────────────── {#38;2;122;162;247}●{#} {#38;2;247;118;142}●{#} {#38;2;86;95;137}󰁔{#} {#1;38;2;187;154;247}◉ 虚式「茈」{#}{#38;2;59;66;97} ────────────────╮{#}"
        },
        {
            "type": "title",
            "key": "{#38;2;59;66;97}│{#} {#1;38;2;187;154;247}󰣇 Sorcerer    {$1}",
            "format": "{#1;38;2;125;207;255}{user-name}{#}{#38;2;86;95;137}@{#}{#1;38;2;187;154;247}{host-name}{#}"
        },
        {
            "type": "datetime",
            "key": "{#38;2;59;66;97}│{#} {#38;2;187;154;247}󰃰 Domain      {$1}",
            "format": "{#38;2;192;202;245}{year}-{month-pretty}-{day-in-month}{#}{#38;2;86;95;137} • {#}{#38;2;125;207;255}{hour-pretty}:{minute-pretty}:{second-pretty}{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}├───────────────┼──────────────── {#1;38;2;125;207;255}󰈈 SIX EYES // SYSTEM{#}{#38;2;59;66;97} ──────────────┤{#}"
        },
        {
            "type": "os",
            "key": "{#38;2;59;66;97}│{#} {#38;2;125;207;255} Distro      {$1}",
            "format": "{name~0,30} {version~0,12} {#38;2;86;95;137}[{arch}]{#}"
        },
        {
            "type": "kernel",
            "key": "{#38;2;59;66;97}│{#} {#38;2;125;207;255} Kernel      {$1}",
            "format": "{sysname} {release~0,42}"
        },
        {
            "type": "packages",
            "key": "{#38;2;59;66;97}│{#} {#38;2;125;207;255}󰏖 Packages    {$1}"
        },
        {
            "type": "uptime",
            "key": "{#38;2;59;66;97}│{#} {#38;2;125;207;255}󰅐 Uptime      {$1}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}├───────────────┼──────────────── {#1;38;2;122;162;247}󰆍 LIMITLESS // ENV{#}{#38;2;59;66;97} ────────────────┤{#}"
        },
        {
            "type": "shell",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247} Shell       {$1}",
            "format": "{pretty-name} {#38;2;86;95;137}v{version}{#}"
        },
        {
            "type": "terminal",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247} Terminal    {$1}",
            "format": "{pretty-name~0,48}"
        },
        {
            "type": "terminalfont",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247} Font        {$1}",
            "format": "{name~0,38} {#38;2;86;95;137}({size}){#}"
        },
        {
            "type": "wm",
            "key": "{#38;2;59;66;97}│{#} {#38;2;122;162;247} WM / DE     {$1}",
            "format": "{pretty-name~0,34}{?protocol-name} {#38;2;86;95;137}({protocol-name}){#}{?}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}├───────────────┼──────────────── {#1;38;2;247;118;142}󰓅 REVERSAL // HARDWARE{#}{#38;2;59;66;97} ────────────┤{#}"
        },
        {
            "type": "host",
            "key": "{#38;2;59;66;97}│{#} {#38;2;247;118;142}󰌢 Machine     {$1}",
            "format": "{name~0,48}"
        },
        {
            "type": "cpu",
            "key": "{#38;2;59;66;97}│{#} {#38;2;247;118;142}󰻠 CPU         {$1}",
            "showPeCoreCount": true,
            "format": "{name~0,33} {#38;2;86;95;137}({cores-logical}T{?freq-max} @ {freq-max}{?}){#}"
        },
        {
            "type": "gpu",
            "key": "{#38;2;59;66;97}│{#} {#38;2;247;118;142}󰍛 GPU         {$1}",
            "format": "{name~0,48}"
        },
        {
            "type": "memory",
            "key": "{#38;2;59;66;97}│{#} {#38;2;187;154;247}󰑭 Memory      {$1}",
            "format": "{percentage-bar} {#38;2;192;202;245}{used}{#}{#38;2;86;95;137} / {total} ({percentage}){#}"
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "{#38;2;59;66;97}│{#} {#38;2;187;154;247}󰉉 Disk (/)    {$1}",
            "format": "{size-percentage-bar} {#38;2;192;202;245}{size-used}{#}{#38;2;86;95;137} / {size-total} ({size-percentage}){#}"
        },
        {
            "type": "localip",
            "compact": true,
            "key": "{#38;2;59;66;97}│{#} {#38;2;187;154;247}󰩟 Local IP    {$1}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}├───────────────┴────────────┬───────────────────────────────────────┤{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}│{#}   {#38;2;247;118;142}{#}  {#38;2;255;158;100}{#}  {#38;2;224;175;104}{#}  {#38;2;158;206;106}{#}  {#38;2;125;207;255}{#}  {#38;2;122;162;247}{#}  {#38;2;187;154;247}{#}  {#38;2;192;202;245}{#}   {#38;2;59;66;97}│{#}      {#1;38;2;187;154;247}Throughout Heaven and Earth{#}      {#38;2;59;66;97}│{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;59;66;97}╰────────────────────────────┴───────────────────────────────────────╯{#}"
        }
    ]
}
